# ============================================================
# MalariaNet — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# --- Virtual environment ---
.venv/
venv/
env/

