cell_images/

# --- Temporary model files from quantization benchmarking ---
original_model_temp.pth
quantized_model_temp.pth

# --- Generated root-level images ---
/*.png

# --- OS junk ---
Thumbs.db
.DS_Store
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- uv ---
uv.lock
